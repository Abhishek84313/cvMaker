{
  "manifest_version": 3,
  "name": "CVMaker Extractor",
  "version": "1.0.0",
  "description": "Extrait les informations d'offres d'emploi pour CVMaker Engine",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "sidebar_action": {
    "default_title": "CVMaker Engine",
    "default_panel": "sidebar/sidebar.html"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Ouvrir le panneau CVMaker"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/content.js",
        "./adapters/generic.js"
    ],
      "css": ["content/styles.css"]
    }
  ]
}